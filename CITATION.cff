cff-version: 1.2.0
title: "CLASHarness: Generating Controllable and Verifiable Multi-Agent Conflict Scenarios in Computer Use"
message: "If you use CLASHarness, please cite the repository and the accompanying paper."
type: software
authors:
  - family-names: Lai
    given-names: Yuxiang
  - family-names: Zhong
    given-names: Jike
  - family-names: Liu
    given-names: Chengzhi
  - family-names: Li
    given-names: Ming
  - family-names: Wang
    given-names: Haonan
  - family-names: Yang
    given-names: Xiaofeng
